{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@crm/crm@browser": ["libs/core/browser/src/index.ts"],
      "@crm/crm@core/auth": ["libs/core/auth/src/index.ts"],
      "@crm/crm@ngrx": ["libs/core/ngrx/src/index.ts"],
      "@crm/crm@permissions": ["libs/core/permissions/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
